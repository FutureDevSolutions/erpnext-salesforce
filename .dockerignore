# Keep the build context small. Without this the context is ~2.2GB, almost all
# of it git history that the image never needs.

# 1.7GB of history. frappe_docker strips .git from apps in its production
# image too; Frappe falls back gracefully when an app has no git metadata.
.git
.github
.git-blame-ignore-revs

# Reinstalled inside the builder stage (323MB of it is banking/).
node_modules
banking/node_modules

# Build outputs - regenerated by `bench build --production`.
erpnext/public/dist
erpnext/public/banking
erpnext/www/banking.html
banking/dist

# Python artefacts
**/__pycache__
**/*.py[cod]
*.egg-info
.python-version

# Local tooling and editor state
.claude
.playwright-cli
.vscode
.idea
.helix
.aider*
.DS_Store

# Internal planning docs. REBRAND-PLAN.md describes commercial and licensing
# strategy - it must not end up baked into a shipped container, least of all an
# on-prem build where GPL-3.0 s.6 obliges us to hand over the image's source.
REBRAND-PLAN.md

# Never bake secrets into a layer.
deploy/.env
**/*.pem
**/*.key

# The local dev stack (bind-mounts an absolute host path, hardcodes a throwaway
# database password). Nothing in a production image should reference it.
docker-compose.yml
