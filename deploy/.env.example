# Copy to deploy/.env and fill in. deploy/.env is gitignored and excluded from
# the Docker build context - keep it that way.
#
#   cp deploy/.env.example deploy/.env

# ---------------------------------------------------------------- identity
# The site name IS the hostname Frappe matches on. It must equal the domain
# users browse to, or nginx passes an X-Frappe-Site-Name the backend does not
# recognise and every request 404s.
SITE_NAME=erp.example.com

# Port on the host that nginx binds to. Put your TLS terminator in front of it.
HTTP_PORT=8080

# Image tag to run. Override in CI to deploy a specific build.
IMAGE=erpnext-salesforce:latest

# ---------------------------------------------------------------- database
# Managed MariaDB 10.6+ (11.x recommended). PostgreSQL is not supported here:
# ERPNext officially targets MariaDB.
#
# deploy/preflight-db.sh probes DB_HOST:DB_PORT before every deploy:
#   - reachable + credentials work -> used as-is
#   - nothing listening            -> a MariaDB container is created for you
#   - answers but rejects the creds-> yours is left untouched and a separate
#                                     instance is created on the next free port
# When it provisions, it REWRITES DB_HOST/DB_PORT/DB_VOLUME_NAME in this file
# (keeping a .bak). Pass --no-provision to fail instead of auto-creating.
#
# Leave DB_HOST empty or set it to `mariadb` to always use a managed-by-us DB.
# A managed instance must be started with utf8mb4 defaults:
#   character-set-server=utf8mb4
#   collation-server=utf8mb4_unicode_ci
#   skip-character-set-client-handshake
DB_HOST=
DB_PORT=3306

# --- only used when preflight-db.sh provisions the database itself ---
# Set automatically if a fallback instance is created; each instance needs its
# own volume, because MariaDB fixes the root password at first initialisation.
DB_VOLUME_NAME=erpnext-mariadb-data
# InnoDB page cache. Rule of thumb: ~70% of the RAM you give the database.
DB_BUFFER_POOL_SIZE=1G
# Each gunicorn thread and each background worker holds a connection.
DB_MAX_CONNECTIONS=200

# Used ONLY by the one-shot create-site job, which creates the site's own
# database and user. Comment both out after the first successful deploy - the
# long-running services never read them.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# ------------------------------------------------------------------- redis
# Redis runs inside the stack, so these are compose service names and need no
# password. Leave them alone unless you are moving to managed Redis.
#
# Do NOT point these at 127.0.0.1. They are resolved from inside a container,
# where 127.0.0.1 is that container's own loopback - never the host's. A Redis
# running natively on the host is unreachable at that address, and the failure
# surfaces late and unhelpfully: the entrypoint's TCP wait times out and the
# one-shot create-site job exits 1 with the reason buried in its own log.
#
# Managed Redis instead: use its hostname, rediss:// for TLS, and keep cache and
# queue on separate instances - maxmemory-policy is server-wide, so sharing one
# would let cache eviction silently drop queued jobs.
REDIS_CACHE=redis://redis-cache:6379/0
REDIS_QUEUE=redis://redis-queue:6379/0

# ------------------------------------------------------------------ secrets
# Administrator password for the initial site. Change it after first login.
ADMIN_PASSWORD=

# Frappe encrypts stored third-party credentials with this. Generate once and
# never rotate casually - changing it makes existing secrets undecryptable:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# -------------------------------------------------------------------- SMTP
# Optional. Frappe normally sends through the Email Account doctype; these are
# the bootstrap fallback that makes password reset work before one exists.
MAIL_SERVER=
MAIL_PORT=587
MAIL_LOGIN=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=1

# ------------------------------------------------------------------ tuning
# Rule of thumb: (2 x cores) + 1, then size threads to your DB connection cap.
# Each worker is a process; workers x threads is your concurrent DB connections.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Memory ceiling for the cache instance. It evicts least-recently-used keys at
# this limit rather than running the host out of memory. The queue instance is
# deliberately uncapped - see docker-compose.prod.yml.
REDIS_CACHE_MAXMEMORY=512mb

# Raise if users upload large attachments.
CLIENT_MAX_BODY_SIZE=50m
# Raise if you have long-running reports; must exceed GUNICORN_TIMEOUT.
PROXY_READ_TIMEOUT=120
